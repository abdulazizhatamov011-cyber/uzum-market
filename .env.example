# SMS orqali tasdiqlash kodi yuborish uchun Eskiz.uz akkaunti (https://eskiz.uz)
# Ushbu faylni .env.local nomi bilan nusxalang va qiymatlarni to'ldiring.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Eskiz'da tasdiqlangan jo'natuvchi nomi (standart: 4546)
ESKIZ_FROM=4546

# Admin panel (/admin) paroli — productionda majburiy. Bo'sh qolsa, dev rejimida vaqtinchalik "admin123" ishlaydi.
ADMIN_PASSWORD=
# Ixtiyoriy: sessiya imzosi uchun uzun tasodifiy satr
ADMIN_SECRET=
